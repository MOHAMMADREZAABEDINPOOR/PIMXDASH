{
  "manifest_version": 3,
  "name": "PIMXDASH - Bookmark Command Center",
  "short_name": "PIMXDASH",
  "version": "1.0.0",
  "description": "A bookmark-first command center with smart search, focus tools and live weather.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "history",
    "tabs",
    "topSites",
    "geolocation",
    "favicon",
    "system.cpu",
    "system.memory",
    "alarms",
    "notifications"
  ],
  "host_permissions": ["https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*", "https://api.bigdatacloud.net/*", "https://hacker-news.firebaseio.com/*", "https://api.rss2json.com/*", "https://www.cloudflare.com/*", "https://zenquotes.io/*", "https://dummyjson.com/*", "https://api.quotable.io/*"],
  "background": { "service_worker": "assets/background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["assets/content.js"], "run_at": "document_idle" }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
